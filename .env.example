# Copy to .env and fill in real values. .env is gitignored.

# ── MetaTrader 5 broker credentials ─────────────────────
# Two ways to connect:
#  A) Attach mode (recommended for personal use):
#       Leave MT5_LOGIN blank (or 0). Start MT5 manually, log in to your
#       broker, leave it running. The bot will attach to that session — no
#       broker password lives in this file.
#  B) Credential mode:
#       Set MT5_LOGIN / MT5_PASSWORD / MT5_SERVER. The bot logs in itself
#       on each start. Convenient for headless deployment, but the password
#       is then stored in plaintext in .env (gitignored, but still on disk).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ── Trading config ──────────────────────────────────────
# SYMBOL must match the exact string in MT5 Market Watch — varies by broker
# (XAUUSD, XAUUSDm, XAUUSD.pro, GOLD, etc.)
SYMBOL=XAUUSD
STARTING_EQUITY=100000
RISK_PCT=0.03
MAGIC_NUMBER=20260101

# Halt trading and require manual restart if equity drops this fraction
# from starting equity. Recommended values:
#   0.10  — first 30 live trades (tight)
#   0.15  — trades 30–100 (validating)
#   0.30  — production after 100 trades (default)
CIRCUIT_BREAKER_PCT=0.30

# ── Strategy lookback windows ───────────────────────────
# ATR_SHORT_PERIOD is the "fast" ATR used as the range floor (range >= atr_short)
# and Filter C trigger. Spec default 20 — the typical daily ATR window.
# ATR_LONG_PERIOD is the "slow" baseline used by the regime classifier
# (ratio = atr_short / atr_long). Spec default 50.
# Increase periods for smoother but laggier signals; decrease for faster reaction.
# Both periods must be ≤ 200 (SMA200 history is the limit).
ATR_SHORT_PERIOD=20
ATR_LONG_PERIOD=50

# ── Operational mode ────────────────────────────────────
# live    — real trades via MT5
# paper   — replay last 30 days at accelerated speed, simulated trades
# dryrun  — reads real MT5 quotes + computes everything, but never sends
#           orders. Use this to validate live mechanics before flipping live.
MODE=paper

# ── Manual confirmation (live safety net) ───────────────
# When true, every signal pauses for human approval in the dashboard.
# Useful for the first 30 live trades. Expires after the timeout.
REQUIRE_CONFIRMATION=false
CONFIRMATION_TIMEOUT_SEC=30

# ── Order-send resilience (MT5) ─────────────────────────
# Retries on requote / price-changed / timeout with a fresh price, and
# falls back across IOC/FOK/RETURN filling modes. Backoff grows linearly
# (backoff × attempt). Terminal rejects (no money, market closed, trade
# disabled) are surfaced immediately without retry.
ORDER_MAX_ATTEMPTS=3
ORDER_RETRY_BACKOFF_SEC=0.5

# ── Web UI ──────────────────────────────────────────────
# The bot serves with NO authentication. Keep WEBAPP_HOST=127.0.0.1
# so only your own machine can reach it. If you need remote access, run
# a reverse proxy (Caddy / nginx / Cloudflare Tunnel) in front and put
# auth at that layer.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# ── COMEX volume webhook (Opt 1) ────────────────────────
COMEX_WEBHOOK_HOST=0.0.0.0
COMEX_WEBHOOK_PORT=5050
COMEX_WEBHOOK_ENABLED=true

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
