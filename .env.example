# Copy to .env and fill in real values. .env is gitignored.

# ── MetaTrader 5 broker credentials ─────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=BrokerName-Demo
MT5_TERMINAL_PATH=

# ── Trading config ──────────────────────────────────────
SYMBOL=XAUUSD
STARTING_EQUITY=100000
RISK_PCT=0.03
MAGIC_NUMBER=20260101

# ── Operational mode ────────────────────────────────────
# live | paper | dryrun
MODE=paper

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
