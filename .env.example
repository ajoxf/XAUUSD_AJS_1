# Copy to .env and fill in real values. .env is gitignored.

# ── MetaTrader 5 broker credentials ─────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=BrokerName-Demo
MT5_TERMINAL_PATH=

# ── Trading config ──────────────────────────────────────
SYMBOL=XAUUSD
STARTING_EQUITY=100000
RISK_PCT=0.03
MAGIC_NUMBER=20260101

# ── Operational mode ────────────────────────────────────
# live | paper | dryrun
MODE=paper

# ── Web UI ──────────────────────────────────────────────
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately
SECRET_KEY=set-a-random-string-here

# ── COMEX volume webhook (Opt 1) ────────────────────────
COMEX_WEBHOOK_HOST=0.0.0.0
COMEX_WEBHOOK_PORT=5050
COMEX_WEBHOOK_ENABLED=true

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
