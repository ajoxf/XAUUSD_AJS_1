# Copy to .env and fill in real values. .env is gitignored.

# ── MetaTrader 5 broker credentials ─────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your-password-here
MT5_SERVER=BrokerName-Demo
MT5_TERMINAL_PATH=

# ── Trading config ──────────────────────────────────────
SYMBOL=XAUUSD
STARTING_EQUITY=100000
RISK_PCT=0.03
MAGIC_NUMBER=20260101

# ── Operational mode ────────────────────────────────────
# live | paper | dryrun
MODE=paper

# ── Web UI ──────────────────────────────────────────────
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Authentication.
# Leave ADMIN_PASSWORD BLANK to disable auth entirely (only allowed on
# 127.0.0.1 — the app refuses to start with no password on any other host).
# Set ADMIN_PASSWORD to require HTTP Basic Auth on every page and API call.
# REQUIRED if you ever bind to 0.0.0.0, your LAN, or expose the port.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Flask session secret. Auto-generated per-run if blank; set for persistence.
SECRET_KEY=

# ── COMEX volume webhook (Opt 1) ────────────────────────
COMEX_WEBHOOK_HOST=0.0.0.0
COMEX_WEBHOOK_PORT=5050
COMEX_WEBHOOK_ENABLED=true

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
